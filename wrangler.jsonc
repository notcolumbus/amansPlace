{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amansplace",
  "account_id": "f5a01b2a1b774ef900536723435cd5d0",
  "compatibility_date": "2026-11-03",
  "routes": [
    { "pattern": "amans.place/*", "zone_name": "amans.place" },
    { "pattern": "www.amans.place/*", "zone_name": "amans.place" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
